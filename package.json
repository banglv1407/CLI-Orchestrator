{
  "name": "clx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-jsnes-ppu.mjs",
    "predev": "node scripts/patch-jsnes-ppu.mjs",
    "dev": "vite --force --configLoader native",
    "prebuild": "node scripts/patch-jsnes-ppu.mjs",
    "build": "tsc && vite build",
    "build:modules": "npm run build:quickapps-ui && npm run build:api-client-ui && npm run build:cli-proxy-ui && npm run build:ai-companion-ui && npm run build:local-llm-ui && npm run build:ssh-ui && npm run build:buzz-ui && npm run build:nes-ui && npm run build:pet-ui",
    "build:quickapps-ui": "tsc -p modules/clx.quickapps/ui/tsconfig.json && vite build --config modules/clx.quickapps/ui/vite.config.mjs",
    "build:api-client-ui": "tsc -p modules/clx.api-client/ui/tsconfig.json && vite build --config modules/clx.api-client/ui/vite.config.mjs",
    "build:cli-proxy-ui": "tsc -p modules/clx.cli-proxy/ui/tsconfig.json && vite build --config modules/clx.cli-proxy/ui/vite.config.mjs",
    "build:ai-companion-ui": "tsc -p modules/clx.ai-companion/ui/tsconfig.json && vite build --config modules/clx.ai-companion/ui/vite.config.mjs",
    "build:local-llm-ui": "tsc -p modules/clx.local-llm/ui/tsconfig.json && vite build --config modules/clx.local-llm/ui/vite.config.mjs",
    "build:ssh-ui": "tsc -p modules/clx.ssh/ui/tsconfig.json && vite build --config modules/clx.ssh/ui/vite.config.mjs",
    "build:buzz-ui": "tsc -p modules/clx.buzz/ui/tsconfig.json && vite build --config modules/clx.buzz/ui/vite.config.mjs",
    "build:nes-ui": "tsc -p modules/clx.nes/ui/tsconfig.json && vite build --config modules/clx.nes/ui/vite.config.mjs",
    "build:pet-ui": "tsc -p modules/clx.pet/ui/tsconfig.json && vite build --config modules/clx.pet/ui/vite.config.mjs",
    "build:quickapps-sidecar": "cargo build -p clx-quickapps-sidecar --release",
    "stage:modules": "node scripts/stage-modules.mjs && node scripts/stage-api-client.mjs && node scripts/stage-cli-proxy.mjs && node scripts/stage-ai-companion.mjs && node scripts/stage-local-llm.mjs && node scripts/stage-ssh.mjs",
    "stage:modules:dev": "node scripts/stage-modules.mjs --dev && node scripts/stage-api-client.mjs --dev && node scripts/stage-cli-proxy.mjs --dev && node scripts/stage-ai-companion.mjs --dev && node scripts/stage-local-llm.mjs --dev && node scripts/stage-ssh.mjs --dev",
    "generate:modules-nsh": "node scripts/generate-modules-nsh.mjs",
    "verify:core-boundaries": "node scripts/verify-core-boundaries.mjs",
    "build:production": "node scripts/build-production.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:nes-patch": "node --test scripts/patch-jsnes-ppu.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "jsnes": "2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
